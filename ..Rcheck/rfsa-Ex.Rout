> ### Name: calc_arcco_payment
> ### Title: Calculate ARC-CO Payment
> ### Aliases: calc_arcco_payment
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Calculate ARC-CO payment for corn in 2023
> ##D payment <- calc_arcco_payment(
> ##D   crop = "corn",
> ##D   program_year = 2023,
> ##D   base_acres = 100,
> ##D   fips = 17001
> ##D )
> ##D 
> ##D # Calculate with custom parameters
> ##D payment <- calc_arcco_payment(
> ##D   crop = "soybeans",
> ##D   program_year = 2023,
> ##D   base_acres = 250,
> ##D   cov_lvl = 0.80,
> ##D   state = "Iowa",
> ##D   county = "Story"
> ##D )
> ## End(Not run)
> 
